{
  "schemaVersion": 1,
  "id": "villagecolony",
  "version": "${version}",
  "name": "Village Colony",
  "description": "Transforms vanilla villages into autonomous living colonies. Villagers organize themselves, manage resources, produce materials and expand the settlement without player intervention.",
  "authors": [
    "Lucas Riboldi"
  ],
  "contact": {
    "homepage": "https://github.com/LucasRiboldi/MOD-village-1.21.1",
    "sources": "https://github.com/LucasRiboldi/MOD-village-1.21.1",
    "issues": "https://github.com/LucasRiboldi/MOD-village-1.21.1/issues"
  },
  "license": "MIT",
  "icon": "assets/villagecolony/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.villagecolony.VillageColonyMod"
    ],
    "client": [
      "com.villagecolony.client.VillageColonyClient"
    ],
    "modmenu": [
      "com.villagecolony.client.modmenu.VillageColonyModMenu"
    ]
  },
  "mixins": [
    "villagecolony.mixins.json",
    {
      "config": "villagecolony.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
