{
  "schemaVersion": 1,
  "id": "villagecolony-gametest",
  "version": "1.0.0",
  "name": "Village Colony Game Tests",
  "description": "Os testes de jogo do Village Colony. Existe como mod separado para que os entrypoints de gametest fiquem fora do jar publicado: um servidor dedicado carrega o entrypoint 'fabric-gametest' no boot, e apontar para classes que não estão no jar derruba o servidor antes de o mod iniciar.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": [
      "com.villagecolony.gametest.ColonyDetectionGameTest",
      "com.villagecolony.gametest.StorageGameTest",
      "com.villagecolony.gametest.LumberjackGameTest",
      "com.villagecolony.gametest.ChestMarkerGameTest",
      "com.villagecolony.gametest.WorkerLossGameTest",
      "com.villagecolony.gametest.ColonyCycleGameTest",
      "com.villagecolony.gametest.BlockProtectionGameTest",
      "com.villagecolony.gametest.ChestWithdrawerGameTest",
      "com.villagecolony.gametest.CraftingLookupGameTest",
      "com.villagecolony.gametest.ManufacturerGameTest",
      "com.villagecolony.gametest.WorkerEquipmentGameTest",
      "com.villagecolony.gametest.BlueprintReaderGameTest",
      "com.villagecolony.gametest.BuildSiteGameTest",
      "com.villagecolony.gametest.BuilderGameTest",
      "com.villagecolony.gametest.ConstructionResumeGameTest",
      "com.villagecolony.gametest.FreeChestCountGameTest"
    ]
  },
  "depends": {
    "villagecolony": "*"
  }
}
